# Copy to .env.local and fill in. .env.local is git-ignored — never commit it.
# Local Supabase: run `npm run env:local` and this file is written for you.
# Hosted Supabase: Dashboard → Project Settings → API Keys.

# Safe to ship to browsers (Row Level Security protects the data):
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: Cloudflare Turnstile site key — only if you turned on CAPTCHA in Supabase Auth.
VITE_TURNSTILE_SITE_KEY=

# For scripts only (simulate.ts against a hosted project). Never put a service
# role / secret key in a VITE_ variable: VITE_ values are copied into the app
# that every visitor downloads. Locally you don't need it — the scripts read
# the local keys from `supabase status` themselves.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
