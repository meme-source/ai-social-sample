# Secrets for the room-ai function when it runs locally.
#   cp supabase/functions/.env.example supabase/functions/.env.local
#   npm run functions:serve
# Hosted project: set them with `npx supabase secrets set ...` (README step 5).
# Never commit real keys; .env.local is git-ignored.

# Local mock LLM (start it with `npm run mock-llm`).
# host.docker.internal means "this Mac" as seen from inside Docker.
LLM_BASE_URL=http://host.docker.internal:8787/v1
LLM_MODEL=mock-chat
LLM_API_KEY=mock-key

# Real DeepSeek instead (default model, non-thinking mode is sent automatically):
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-flash
# LLM_API_KEY=<your DeepSeek key>

# Optional tuning
# LLM_TIMEOUT_MS=8000
# LLM_MAX_TOKENS=120
# LLM_EXTRA_BODY={"thinking":{"type":"disabled"}}
